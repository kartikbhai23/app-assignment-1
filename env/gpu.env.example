# GPU host only (compose.gpu.yml). Copy to env/gpu.env on the GPU instance.
# The GPU instance's private IP on the Jetstream2 private network, for example
# 10.0.12.34 (find it with `ip -4 addr` or in Exosphere). Never 0.0.0.0 or the
# public IP: vLLM must be reachable only from the CPU instance.
VLLM_BIND_IP=
